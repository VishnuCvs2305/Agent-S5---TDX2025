<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Display_Case_Details</name>
        <label>Display Case Details</label>
        <locationX>182</locationX>
        <locationY>866</locationY>
        <assignmentItems>
            <assignToReference>DisplayCaseNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Created_Case.CaseNumber</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DisplayCaseSubject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Created_Case.Subject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DisplayCaseStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Created_Case.Status</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_For_Delay_Compensation_Request</name>
        <label>Check For Delay Compensation Request</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Display_Case_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Check_Voyage_Number_is_needed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Created_Case.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Refund</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Created_Case.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Repay</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Created_Case.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Compensation</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Created_Case.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Delay</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Created_Case.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>ReturnMoney</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Created_Case.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Delayed</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Is_Refund_Requested</targetReference>
            </connector>
            <label>Outcome 1 of Check Voyage Number is needed</label>
        </rules>
    </decisions>
    <description>This flow is used to create a new case</description>
